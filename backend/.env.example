# Copy to .env for local runs. In production, inject via your platform's secret manager.
AEGIS_SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars
AEGIS_ENVIRONMENT=production
# PostgreSQL example:
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:password@db:5432/aegis
AEGIS_DATABASE_URL=sqlite:///./aegis.db
AEGIS_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]
# Billing (spec §4) — leave disabled until the owner has a provider
# account + KYC. Then set the provider (stripe|razorpay), the webhook
# secret from the provider dashboard, and hosted-checkout URLs (Stripe
# Payment Links / Razorpay Payment Pages). Prices are display-only.
# AEGIS_BILLING_ENABLED=true
# AEGIS_BILLING_PROVIDER=stripe
# AEGIS_BILLING_WEBHOOK_SECRET=
# AEGIS_BILLING_CHECKOUT_URL_MONTHLY=
# AEGIS_BILLING_CHECKOUT_URL_ANNUAL=
# AEGIS_PRO_PRICE_MONTHLY_DISPLAY=
# AEGIS_PRO_PRICE_ANNUAL_DISPLAY=
# External ad network slot (spec §3) — leave disabled until the owner
# creates the network account. Frame origin is added to the SPA CSP
# frame-src only while enabled; the slot still needs visitor consent.
# AEGIS_ADS_NETWORK_ENABLED=true
# AEGIS_ADS_NETWORK_FRAME_SRC=https://ads.example.invalid
# AEGIS_ADS_NETWORK_SLOT_URL=
