# Copy to .env for local runs. In production, inject via your platform's secret manager.
AEGIS_SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars
AEGIS_ENVIRONMENT=production
# PostgreSQL example:
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:password@db:5432/aegis
AEGIS_DATABASE_URL=sqlite:///./aegis.db
AEGIS_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]
# Proxy chain (rate limiting). Set TRUST_PROXY=true only behind a proxy that
# appends X-Forwarded-For (Render does). TRUSTED_PROXY_HOPS = how many trusted
# hops append from the right (Render = 1). Startup refuses trust_proxy with
# hops < 1 — a spoofable rate-limit bucket is worse than none.
AEGIS_TRUST_PROXY=false
AEGIS_TRUSTED_PROXY_HOPS=1
# Account creations allowed per IP per hour (bulk-signup barrier).
AEGIS_REGISTER_RATE_LIMIT_PER_HOUR=3
